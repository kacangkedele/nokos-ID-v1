# Contoh environment variables untuk PRODUCTION (Cloudflare Secrets).
# Salin referensi ini; isi nilai asli via `npx wrangler pages secret put <NAMA>`.
# JANGAN commit file .env berisi secret asli ke repository.

JWT_SECRET=generate-via-openssl-rand-hex-32
ENCRYPTION_KEY=generate-via-openssl-rand-hex-32
RUANGOTP_API_KEY=your-ruangotp-api-key-from-dashboard
RUANGOTP_BASE_URL=https://ruangotp.io/api
RUANGOTP_WEBHOOK_SECRET=shared-secret-from-provider-dashboard
QRIS_MERCHANT_NAME=Angga Official
